{
  "name": "yeet-design-system",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "description": "YeetStyle design system: tokens, atoms, molecules, organisms, templates — with Storybook docs",
  "scripts": {
    "tokens": "node scripts/build-tokens.mjs",
    "storybook": "node scripts/build-assets.mjs && storybook dev -p 6006",
    "build-storybook": "node scripts/build-tokens.mjs && node scripts/build-assets.mjs && storybook build -o storybook-static && node scripts/postbuild.mjs",
    "typecheck": "tsc --noEmit",
    "qa": "node scripts/qa/run.mjs",
    "contrast": "node scripts/check-contrast.mjs",
    "figma-sync": "node scripts/tokens/figma-sync.mjs",
    "flow-diff": "node scripts/qa/flow-diff.mjs",
    "test-storybook": "node scripts/build-assets.mjs && vitest run --project=storybook",
    "assets": "node scripts/build-assets.mjs",
    "team": "node scripts/team/status.mjs",
    "docs-tokens": "node scripts/docs/design-md.mjs",
    "lint": "eslint . --max-warnings 0 && stylelint \"**/*.css\" --max-warnings 0",
    "lint:js": "eslint . --max-warnings 0",
    "lint:css": "stylelint \"**/*.css\" --max-warnings 0",
    "format:check": "node scripts/format-check.mjs",
    "changeset": "changeset",
    "release:version": "changeset version && node scripts/tokens-changelog.mjs --write",
    "release:notes": "node scripts/release-notes.mjs",
    "tokens:changelog": "node scripts/tokens-changelog.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^9.39.5",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.0.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.0.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-storybook": "^10.6.0",
    "globals": "^17.12.0",
    "lefthook": "^2.1.14",
    "lint-staged": "^17.6.0",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "playwright-core": "^1.63.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.0.0",
    "style-dictionary": "^5.5.5",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.11"
  }
}
