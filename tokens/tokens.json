  "component": {
    "button-primary-bg": "{color.accent}",
    "button-primary-fg": "{color.text-on-accent}",
    "button-secondary-bg": "{color.bg-inverse}",
    "button-secondary-fg": "{color.text-inverse}",
    "button-tertiary-bg": "{color.bg-subtle}",
    "button-tertiary-fg": "{color.text-primary}",
    "button-inverse-bg": "{color.bg-elevated}",
    "button-inverse-fg": "{color.text-primary}",
    "button-ghost-bg": "transparent",
    "button-ghost-fg": "{color.text-primary}",
    "button-soft-bg": "{color.accent-soft}",
    "button-soft-fg": "{color.text-accent}",
    "button-destructive-bg": "{color.danger-soft}",
    "button-destructive-fg": "{color.text-danger}",
    "card-bg": "{color.bg-subtle}",
    "card-radius": "{radius.lg}",
    "sheet-bg": "{color.bg-elevated}",
    "sheet-radius": "{radius.xl}",
    "sheet-radius-bottom": "{radius.bar}",
    "tab-bar-bg": "{color.bg-elevated}",
    "input-bg": "{color.bg-subtle}"
  },

  "space": [0, 1, 2, 4, 8, 12, 16, 20, 24, 28, 32, 40, 48, 52, 56, 64, 72],

  "radius": {
    "xs": { "value": 4, "use": "Хэндл sheet" },
    "sm": { "value": 12, "use": "Badge" },
    "md": { "value": 16, "use": "Snackbar, cap столбца графика" },
    "lg": { "value": 20, "use": "Карточки, поля, фото" },
    "xl": { "value": 32, "use": "Кнопки-капсулы, верх sheet, подсказка стилиста" },
    "bar": { "value": 48, "use": "Tab-bar, низ плавающего sheet (концентрично углу экрана)" },
    "full": { "value": 999, "use": "Аватар, радио" }
  },

  "font": {
    "display": { "family": "Roboto Slab", "fallback": "Georgia, serif", "file": "RobotoSlab-Variable.ttf", "android": "roboto_slab_variable", "weights": [380, 400], "source": "Google Fonts · apache/robotoslab" },
    "text": { "family": "Inter", "fallback": "-apple-system, 'Helvetica Neue', Arial, sans-serif", "file": "Inter-Variable.ttf", "android": "inter_variable", "weights": [400, 460], "source": "Google Fonts · ofl/inter" }
  },

  "typography": {
    "h1": { "font": "display", "weight": 380, "size": 32, "lineHeight": 36, "letterSpacing": -1, "use": "Заголовки экранов" },
    "h2": { "font": "display", "weight": 400, "size": 24, "lineHeight": 28, "letterSpacing": -0.4, "use": "Секции, пустые состояния, числа" },
    "h3": { "font": "display", "weight": 400, "size": 19, "lineHeight": 24, "letterSpacing": -0.3, "use": "Заголовки sheet, диалогов, карточек" },
    "body": { "font": "text", "weight": 460, "size": 14, "lineHeight": 20, "letterSpacing": 0, "use": "Текст, кнопки, пункты списков" },
    "caption": { "font": "text", "weight": 400, "size": 12, "lineHeight": 16, "letterSpacing": 0, "use": "Подписи, мета-данные, бейджи" }
  },

  "shadow": {
    "floating": {
      "light": { "x": 0, "y": 8, "blur": 40, "color": "#000000@0.12" },
      "dark": { "x": 0, "y": 8, "blur": 40, "color": "#000000@0.5" },
      "use": "Tab-bar, FAB, hint, панель sheet. Figma: стиль shadow/floating, цвет — переменная ui-colors/shadow"
    }
  },

  "layout": {
    "screen-width": 393,
    "screen-height": 852,
    "screen-gutter": 20,
    "status-bar-height": 62
  },

  "motion": {
    "duration": { "fast": 150, "base": 240, "300": 300 },
    "easing": { "standard": [0.2, 0, 0, 1], "out": [0, 0, 0.58, 1] },
    "spring": {
      "gentle": { "mass": 1, "stiffness": 100, "damping": 15, "duration": 1022, "figma": "Gentle" },
      "quick": { "mass": 1, "stiffness": 300, "damping": 20, "duration": 744, "figma": "Quick" },
      "bouncy": { "mass": 1, "stiffness": 600, "damping": 15, "duration": 958, "figma": "Bouncy" }
    },
    "transition": {
      "press": { "duration": "fast", "easing": "standard", "use": "Нажатие кнопки, scale 0.97" },
      "fade": { "duration": "base", "easing": "standard", "use": "Затухание краёв, тосты" },
      "collapse": { "duration": "300", "easing": "out", "use": "Фото сворачивается в шапку при скролле" },
      "page": { "duration": "300", "easing": "out", "use": "Листание образов и поводов по свайпу" },
      "nav": { "spring": "quick", "use": "Таб-бар уступает место FAB" },
      "stamp": { "spring": "bouncy", "use": "Штамп «Надеть» → отмечено" },
      "swap": { "spring": "gentle", "use": "Смена образа: превью ↔ коллаж" },
      "select": { "duration": "fast", "easing": "standard", "use": "Выбор: фон чипса, вкладки, строки, цвет лайка" },
      "lift": { "spring": "quick", "use": "Подъём под пальцем: вещь на холсте, карточка при перетаскивании" },
      "drop": { "spring": "quick", "use": "Бросок в цель: вещь встаёт на место, соседи раздвигаются" },
      "return": { "spring": "gentle", "use": "Отмена перетаскивания: вещь возвращается туда, откуда взяли" },
      "appear": { "duration": "base", "easing": "standard", "use": "Появление: snackbar, подсказка, диалог" },
      "exit": { "duration": "fast", "easing": "standard", "use": "Исчезновение: быстрее появления, чтобы не мешать" }
    },
    "haptic": {
      "select": { "ios": "selection", "android": "CLOCK_TICK", "when": "Смена выбора: чипс, сегмент, вкладка, радио, шаг слайдера цены", "use": "Каждый шаг — один тик, не чаще 1 раза в 50 мс" },
      "toggle": { "ios": "impact:light", "android": "CONTEXT_CLICK", "when": "Переключатель, лайк, галочка вещи в режиме выбора", "use": "И при включении, и при выключении" },
      "lift": { "ios": "impact:medium", "android": "LONG_PRESS", "when": "Подъём: долгое нажатие сработало, вещь на холсте взята", "use": "В момент подъёма, одновременно с scale 1.04" },
      "target": { "ios": "selection", "android": "CLOCK_TICK", "when": "Перетаскиваемая вещь зашла на новую цель или корзину", "use": "Только при входе в цель, не при движении внутри" },
