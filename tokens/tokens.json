      "text-secondary": { "light": "{primitive.neutral-600}", "dark": "{primitive.graphite-400}", "role": "Вторичный текст, лейблы, подписи", "figma": "ui-colors/grey" },
      "text-inverse": { "light": "{primitive.neutral-0}", "dark": "{primitive.graphite-950}", "role": "Текст на inverse-поверхности", "figma": "ui-colors/white" },
