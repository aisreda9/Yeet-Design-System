{
  "$description": "Yeet Design System — единый источник токенов в формате DTCG (designtokens.org, 2025.10). Из него `npm run tokens` (Style Dictionary) генерирует CSS (Storybook), Swift (iOS / SwiftUI) и Kotlin (Android / Jetpack Compose). Значение `$value` — светлая тема; тёмная тема — `$extensions[\"com.yeet\"].modes.dark` (модификатор темы описан в корневом `$extensions`). Ссылки — \"{group.token}\". Figma: коллекция «Yeet DS 2.0» (Light / Dark).",
  "$extensions": {
    "com.yeet": {
      "modifiers": {
        "theme": {
          "default": "light",
          "contexts": ["light", "dark"],
          "description": "Светлая — `$value`, тёмная — `$extensions[\"com.yeet\"].modes.dark` у токена (если нет — как в светлой)."
        },
        "contrast": {
          "default": "standard",
          "contexts": ["contrast-light", "contrast-dark"],
          "fallback": { "contrast-light": "light", "contrast-dark": "dark" },
          "description": "Повышенный контраст (#117): web — @media (prefers-contrast: more), iOS — Increase Contrast, Android 14+ — UiModeManager.getContrast(). Значение — `modes[\"contrast-light\"]` / `modes[\"contrast-dark\"]`; если нет — значение темы (fallback). Ссылаться только на токены без тем (примитивы) или литералы. Текст на поверхностях ≥ 7 : 1, обводки и разделители ≥ 3 : 1, фокус 3 px."
        }
      },
      "customTypes": {
        "spring": "Пружина Figma Smart Animate: { mass, stiffness, damping, duration }. Web — CSS linear(), iOS — interpolatingSpring, Android — spring().",
        "haptic": "Событие хаптики: { ios: \"selection\" | \"impact:<style>\" | \"notification:<type>\", android: HapticFeedbackConstants, androidMin?, androidFallback? }. `$extensions[\"com.yeet\"].platforms` (web | ios | android, по умолчанию все) — где событие есть; поля ios / android — только у своих платформ. Только веб (`[\"web\"]`) — `$value: {}`, в Swift / Kotlin не генерируется (#130)."
      }
    }
  },
  "primitive": {
    "$type": "color",
    "blue-500": { "$value": { "colorSpace": "srgb", "components": [0.0039, 0, 0.9569], "hex": "#0100F4" } },
    "blue-400": { "$value": { "colorSpace": "srgb", "components": [0.2941, 0.2941, 1], "hex": "#4B4BFF" } },
    "blue-200": { "$value": { "colorSpace": "srgb", "components": [0.5412, 0.5412, 1], "hex": "#8A8AFF" } },
    "red-600": { "$value": { "colorSpace": "srgb", "components": [0.8, 0.1608, 0.1059], "hex": "#CC291B" } },
    "red-500": { "$value": { "colorSpace": "srgb", "components": [1, 0.2588, 0.1882], "hex": "#FF4230" } },
    "red-400": { "$value": { "colorSpace": "srgb", "components": [1, 0.4196, 0.3608], "hex": "#FF6B5C" } },
    "neutral-0": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } },
    "neutral-50": { "$value": { "colorSpace": "srgb", "components": [0.9686, 0.9686, 0.9686], "hex": "#F7F7F7" } },
    "neutral-500": { "$value": { "colorSpace": "srgb", "components": [0.4667, 0.4667, 0.4667], "hex": "#777777" } },
    "neutral-600": { "$value": { "colorSpace": "srgb", "components": [0.4314, 0.4314, 0.4314], "hex": "#6E6E6E" } },
    "neutral-1000": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" } },
    "graphite-50": { "$value": { "colorSpace": "srgb", "components": [0.9608, 0.9608, 0.9686], "hex": "#F5F5F7" } },
    "graphite-400": { "$value": { "colorSpace": "srgb", "components": [0.5569, 0.5569, 0.5765], "hex": "#8E8E93" } },
    "graphite-850": { "$value": { "colorSpace": "srgb", "components": [0.149, 0.149, 0.1686], "hex": "#26262B" } },
    "graphite-900": { "$value": { "colorSpace": "srgb", "components": [0.102, 0.102, 0.1176], "hex": "#1A1A1E" } },
    "graphite-950": { "$value": { "colorSpace": "srgb", "components": [0.0588, 0.0588, 0.0667], "hex": "#0F0F11" } }
  },
  "item": {
    "$type": "color",
    "$description": "Цвет вещи — атрибут одежды, не интерфейс.",
    "black": {
      "$value": { "colorSpace": "srgb", "components": [0.102, 0.102, 0.1804], "hex": "#1A1A2E" },
      "$extensions": { "com.yeet": { "name": "Черный" } }
    },
    "grey": { "$value": "{primitive.neutral-500}", "$extensions": { "com.yeet": { "name": "Серый" } } },
    "white": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" }, "$extensions": { "com.yeet": { "name": "Белый" } } },
    "purple": { "$value": { "colorSpace": "srgb", "components": [0.4157, 0, 1], "hex": "#6A00FF" }, "$extensions": { "com.yeet": { "name": "Фиолетовый" } } },
    "pink": { "$value": { "colorSpace": "srgb", "components": [0.851, 0, 1], "hex": "#D900FF" }, "$extensions": { "com.yeet": { "name": "Розовый" } } },
    "green": { "$value": { "colorSpace": "srgb", "components": [0, 0.8157, 0.5451], "hex": "#00D08B" }, "$extensions": { "com.yeet": { "name": "Зеленый" } } },
    "blue": { "$value": { "colorSpace": "srgb", "components": [0.0039, 0, 0.9569], "hex": "#0100F4" }, "$extensions": { "com.yeet": { "name": "Синий" } } },
    "yellow": { "$value": { "colorSpace": "srgb", "components": [1, 0.8157, 0], "hex": "#FFD000" }, "$extensions": { "com.yeet": { "name": "Желтый" } } },
    "orange": { "$value": { "colorSpace": "srgb", "components": [1, 0.5333, 0], "hex": "#FF8800" }, "$extensions": { "com.yeet": { "name": "Оранжевый" } } },
    "red": { "$value": "{primitive.red-500}", "$extensions": { "com.yeet": { "name": "Красный" } } },
    "beige": { "$value": { "colorSpace": "srgb", "components": [1, 0.8824, 0.7804], "hex": "#FFE1C7" }, "$extensions": { "com.yeet": { "name": "Бежевый" } } },
    "brown": {
      "$value": { "colorSpace": "srgb", "components": [0.7608, 0.3961, 0.2784], "hex": "#C26547" },
      "$extensions": { "com.yeet": { "name": "Коричневый" } }
    }
  },
  "on-item": {
    "$type": "color",
    "$description": "Буква / иконка на цвете вещи (контраст ≥ 4.5 : 1).",
    "black": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } },
    "grey": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" } },
    "white": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" } },
    "purple": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } },
    "pink": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" } },
    "green": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" } },
    "blue": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#FFFFFF" } },
    "yellow": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" } },
    "orange": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" } },
    "red": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" } },
    "beige": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" } },
    "brown": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "hex": "#000000" } }
  },
  "avatar": {
    "$description": "Цвета аккаунтов: фон аватара из цветов вещей, буква — чёрная или белая, у кого контраст выше (все ≥ 4.5 : 1). Белый, бежевый и серый не используются — теряются на белом фоне. Цвет по умолчанию выбирается по id аккаунта.",
    "$extensions": {
      "com.yeet": { "palette": ["blue", "orange", "green", "purple", "pink", "red", "yellow", "brown", "black"] }
    }
  },
  "color": {
    "$type": "color",
    "surface": {
      "$description": "Поверхности",
      "bg-canvas": {
        "$value": "{primitive.neutral-0}",
        "$description": "Фон экрана",
        "$extensions": { "com.yeet": { "figma": "ui-colors/white", "modes": { "dark": "{primitive.graphite-950}" } } }
      },
      "bg-elevated": {
        "$value": "{primitive.neutral-0}",
        "$description": "Поднятые поверхности: tab-bar, sheet, dialog, hint",
        "$extensions": { "com.yeet": { "figma": "ui-colors/elevated", "modes": { "dark": "{primitive.graphite-900}" } } }
      },
      "bg-subtle": {
        "$value": "{primitive.neutral-50}",
        "$description": "Карточки, поля, tertiary-кнопки",
        "$extensions": {
          "com.yeet": { "figma": "ui-colors/light-grey", "modes": { "dark": "{primitive.graphite-850}" } }
        }
      },
      "bg-inverse": {
        "$value": "{primitive.neutral-1000}",
        "$description": "Snackbar, Secondary-кнопка, погода",
        "$extensions": { "com.yeet": { "figma": "ui-colors/bg-inverse", "modes": { "dark": "{primitive.graphite-50}" } } }
      },
      "bg-overlay": {
        "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.4, "hex": "#000000" },
        "$description": "Затемнение под модальным sheet",
        "$extensions": {
          "com.yeet": {
            "figma": "ui-colors/overlay",
            "modes": { "dark": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.6, "hex": "#000000" } }
          }
        }
      }
    },
    "content": {
      "$description": "Контент",
      "text-primary": {
        "$value": "{primitive.neutral-1000}",
        "$description": "Основной текст и иконки",
        "$extensions": { "com.yeet": { "figma": "ui-colors/black", "modes": { "dark": "{primitive.graphite-50}" } } }
      },
      "text-secondary": {
        "$value": "{primitive.neutral-600}",
        "$description": "Вторичный текст, лейблы, подписи",
        "$extensions": {
          "com.yeet": {
            "figma": "ui-colors/grey",
            "modes": {
              "dark": "{primitive.graphite-400}",
              "contrast-light": { "colorSpace": "srgb", "components": [0.3294, 0.3294, 0.3294], "hex": "#545454" },
              "contrast-dark": { "colorSpace": "srgb", "components": [0.698, 0.698, 0.7098], "hex": "#B2B2B5" }
            }
          }
        }
      },
      "text-inverse": {
        "$value": "{primitive.neutral-0}",
        "$description": "Текст на inverse-поверхности",
        "$extensions": { "com.yeet": { "figma": "ui-colors/text-inverse", "modes": { "dark": "{primitive.graphite-950}" } } }
      },
      "text-on-accent": {
        "$value": "{primitive.neutral-0}",
        "$description": "Текст и иконки на accent / danger",
        "$extensions": { "com.yeet": { "figma": "ui-colors/on-accent", "modes": { "dark": "{primitive.neutral-0}" } } }
      },
      "text-inverse-secondary": {
        "$value": { "colorSpace": "srgb", "components": [0.6549, 0.702, 0.749], "hex": "#A7B3BF" },
        "$description": "Вторичный текст на inverse-поверхности: подпись в карточке погоды",
        "$extensions": {
          "com.yeet": {
            "figma": "ui-colors/inverse-secondary",
            "modes": {
              "dark": { "colorSpace": "srgb", "components": [0.3569, 0.3922, 0.4392], "hex": "#5B6470" },
              "contrast-dark": { "colorSpace": "srgb", "components": [0.298, 0.3255, 0.3647], "hex": "#4C535D" }
            }
          }
        }
      },
      "text-on-danger": {
        "$value": "{primitive.neutral-0}",
        "$description": "Текст на danger (бейдж скидки) — белый в любом бренде",
        "$extensions": { "com.yeet": { "figma": "ui-colors/on-accent", "modes": { "dark": "{primitive.neutral-0}" } } }
      },
      "text-on-photo": {
        "$value": "{primitive.neutral-0}",
        "$description": "Статус-бар, логотип, подсказка и иконки поверх фото и тёмной камеры (Splash, Search / Photo / Crop) — белый в любой теме и бренде",
        "$extensions": { "com.yeet": { "figma": "ui-colors/white", "modes": { "dark": "{primitive.neutral-0}" } } }
      },
      "text-accent": {
        "$value": "{primitive.blue-500}",
        "$description": "Акцентный текст, выбранное",
        "$extensions": {
          "com.yeet": {
            "figma": "ui-colors/blue-text",
            "modes": {
              "dark": "{primitive.blue-200}",
              "contrast-dark": { "colorSpace": "srgb", "components": [0.6667, 0.6667, 1], "hex": "#AAAAFF" }
            }
          }
        }
      },
      "text-danger": {
        "$value": "{primitive.red-600}",
        "$description": "Ошибки, деструктивные действия",
        "$extensions": {
          "com.yeet": {
            "figma": "ui-colors/red-text",
            "modes": {
              "dark": "{primitive.red-400}",
              "contrast-light": { "colorSpace": "srgb", "components": [0.6353, 0.1294, 0.0824], "hex": "#A22115" },
              "contrast-dark": { "colorSpace": "srgb", "components": [1, 0.5804, 0.5373], "hex": "#FF9489" }
            }
          }
        }
      }
    },
    "emphasis": {
      "$description": "Акцент, обратная связь, линии",
      "accent": {
        "$value": "{primitive.blue-500}",
        "$description": "Главное действие, выбранное, фокус",
        "$extensions": {
          "com.yeet": {
            "figma": "ui-colors/blue",
            "modes": {
              "dark": "{primitive.blue-400}",
              "contrast-dark": { "colorSpace": "srgb", "components": [0.3451, 0.3451, 1], "hex": "#5858FF" }
            }
          }
        }
      },
      "accent-soft": {
        "$value": { "colorSpace": "srgb", "components": [0.9451, 0.9569, 1], "hex": "#F1F4FF" },
        "$description": "Фон выбранного чипса (Soft) и сообщения пользователя. Light — сплошной #F1F4FF, а не прозрачный: на сером фоне не темнеет",
        "$extensions": {
          "com.yeet": {
            "figma": "ui-colors/blue-10%",
            "modes": {
              "dark": { "colorSpace": "srgb", "components": [0.2941, 0.2941, 1], "alpha": 0.2, "hex": "#4B4BFF" }
            }
          }
        }
      },
      "danger": {
        "$value": "{primitive.red-600}",
        "$description": "Удаление, ошибка, бейдж скидки",
        "$extensions": { "com.yeet": { "figma": "ui-colors/red", "modes": { "dark": "{primitive.red-600}" } } }
      },
      "danger-soft": {
        "$value": { "colorSpace": "srgb", "components": [1, 0.2588, 0.1882], "alpha": 0.1, "hex": "#FF4230" },
        "$description": "Фон Destructive-кнопки",
        "$extensions": {
          "com.yeet": {
            "figma": "ui-colors/red-10%",
            "modes": {
              "dark": { "colorSpace": "srgb", "components": [1, 0.4196, 0.3608], "alpha": 0.18, "hex": "#FF6B5C" }
            }
          }
        }
      },
      "border-subtle": {
        "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.1, "hex": "#000000" },
        "$description": "Обводки свотчей, гистограмма, фон неактивных точек",
        "$extensions": {
          "com.yeet": {
            "figma": "ui-colors/black-10%",
            "modes": {
              "dark": { "colorSpace": "srgb", "components": [0.9608, 0.9608, 0.9686], "alpha": 0.12, "hex": "#F5F5F7" },
              "contrast-light": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.43, "hex": "#000000" },
              "contrast-dark": { "colorSpace": "srgb", "components": [0.9608, 0.9608, 0.9686], "alpha": 0.36, "hex": "#F5F5F7" }
            }
          }
        }
      },
      "divider": {
        "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.05, "hex": "#000000" },
        "$description": "Разделители строк в input-group и list-group",
        "$extensions": {
          "com.yeet": {
            "figma": "ui-colors/divider",
            "modes": {
              "dark": { "colorSpace": "srgb", "components": [0.9608, 0.9608, 0.9686], "alpha": 0.08, "hex": "#F5F5F7" },
              "contrast-light": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.43, "hex": "#000000" },
              "contrast-dark": { "colorSpace": "srgb", "components": [0.9608, 0.9608, 0.9686], "alpha": 0.36, "hex": "#F5F5F7" }
            }
          }
        }
      },
      "pattern-dot": {
        "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.23, "hex": "#000000" },
        "$description": "Точки фона коллажа и холста (2 px, шаг 10)",
        "$extensions": {
          "com.yeet": {
            "figma": "ui-colors/pattern-dot",
            "modes": {
              "dark": { "colorSpace": "srgb", "components": [0.9608, 0.9608, 0.9686], "alpha": 0.23, "hex": "#F5F5F7" }
            }
          }
        }
      },
      "handle": {
        "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.17, "hex": "#000000" },
        "$description": "Хэндл шторки: декоративный, ≈ 1,5:1 к bg-elevated (D8, #58)",
        "$extensions": {
          "com.yeet": {
            "figma": "ui-colors/handle",
            "modes": {
              "dark": { "colorSpace": "srgb", "components": [0.9608, 0.9608, 0.9686], "alpha": 0.14, "hex": "#F5F5F7" }
            }
          }
        }
      },
      "shadow": {
        "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.12, "hex": "#000000" },
        "$description": "Цвет плавающей тени shadow/floating",
        "$extensions": {
          "com.yeet": {
            "figma": "ui-colors/shadow",
            "modes": { "dark": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0.5, "hex": "#000000" } }
          }
        }
      }
    }
  },
  "component": {
    "button-primary-bg": { "$type": "color", "$value": "{color.emphasis.accent}" },
    "button-primary-fg": { "$type": "color", "$value": "{color.content.text-on-accent}" },
    "button-secondary-bg": { "$type": "color", "$value": "{color.surface.bg-inverse}" },
    "button-secondary-fg": { "$type": "color", "$value": "{color.content.text-inverse}" },
    "button-tertiary-bg": { "$type": "color", "$value": "{color.surface.bg-subtle}" },
    "button-tertiary-fg": { "$type": "color", "$value": "{color.content.text-primary}" },
    "button-inverse-bg": { "$type": "color", "$value": "{color.surface.bg-elevated}" },
    "button-inverse-fg": { "$type": "color", "$value": "{color.content.text-primary}" },
    "button-ghost-bg": { "$type": "color", "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 0, "hex": "#000000" } },
    "button-ghost-fg": { "$type": "color", "$value": "{color.content.text-primary}" },
    "button-soft-bg": { "$type": "color", "$value": "{color.emphasis.accent-soft}" },
    "button-soft-fg": { "$type": "color", "$value": "{color.content.text-accent}" },
    "button-destructive-bg": { "$type": "color", "$value": "{color.emphasis.danger-soft}" },
    "button-destructive-fg": { "$type": "color", "$value": "{color.content.text-danger}" },
    "card-bg": { "$type": "color", "$value": "{color.surface.bg-subtle}" },
    "card-radius": { "$type": "dimension", "$value": "{radius.lg}" },
    "sheet-bg": { "$type": "color", "$value": "{color.surface.bg-elevated}" },
    "sheet-radius": { "$type": "dimension", "$value": "{radius.xl}" },
    "tab-bar-bg": { "$type": "color", "$value": "{color.surface.bg-elevated}" },
    "input-bg": { "$type": "color", "$value": "{color.surface.bg-subtle}" },
    "sheet-top-gap": {
      "$type": "dimension",
      "$value": "{space.8}",
      "$description": "Верх высокой шторки: 8 под статус-баром (D2). Web — статус-бар + 8, натив — 8 от safe area top",
      "$extensions": { "com.yeet": { "after": "{layout.status-bar-height}" } }
    },
    "sheet-handle": { "$type": "color", "$value": "{color.emphasis.handle}", "$description": "Хэндл шторки, 48 × 4 (D8)" },
    "sheet-title-gap": { "$type": "dimension", "$value": "{space.16}", "$description": "Заголовок → контент и заголовок → описание (решение владельца 29.09, #58)" },
    "header-compact-weight": { "$type": "fontWeight", "$value": 600, "$description": "Заголовок компактной шапки: Body полужирным (у Body один вес, #217)" },
    "outfit-pager-end": {
      "$type": "dimension",
      "$value": { "value": -3, "unit": "px" },
      "$description": "Низ стопки образов без таб-бара («Удиви меня»): нижнее превью заходит на 3 в поле экрана (1371:42686)"
    },
    "outfit-pager-end-tab-bar": {
      "$type": "dimension",
      "$value": { "value": 5, "unit": "px" },
      "$description": "Низ стопки образов над таб-баром (главная): 29 до таб-бара = поле 24 + 5 (1371:36589)"
    }
  },
  "space": {
    "0": { "$value": { "value": 0, "unit": "px" }, "$extensions": { "com.yeet": { "figma": "spaces/0" } } },
