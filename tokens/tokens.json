      "text-on-photo": { "light": "{primitive.neutral-0}", "dark": "{primitive.neutral-0}", "role": "Статус-бар, логотип, подсказка и иконки поверх фото и тёмной камеры (Splash, Search / Photo / Crop) — белый в любой теме и бренде", "figma": "ui-colors/white" },
